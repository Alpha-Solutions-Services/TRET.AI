# Copy to .env.local and fill in values. Never commit real secrets.

# Supabase project URL (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon / public key (Settings → API) — safe for the browser and Vercel
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key (Settings → API) — LOCAL ONLY for scripts/create-owner
# Never put this in NEXT_PUBLIC_* and never add it to Vercel
SUPABASE_SERVICE_ROLE_KEY=

# Owner account used by npm run create-owner (local only)
# ADMIN_PASSWORD must never be added to Vercel
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Vektor API (server-only — never NEXT_PUBLIC_*)
# Exact list path / JSON shape still OPEN until confirmed
VEKTOR_API_BASE_URL=
VEKTOR_API_TOKEN=
