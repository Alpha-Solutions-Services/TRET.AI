# Copy to .env.local and fill in values. Never commit real secrets.

# Supabase project URL (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon / public key (Settings → API) — safe for the browser and Vercel
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key (Settings → API) — LOCAL ONLY for scripts/create-owner
# Never put this in NEXT_PUBLIC_* and never add it to Vercel
SUPABASE_SERVICE_ROLE_KEY=

# Owner account used by npm run create-owner (local only)
# ADMIN_PASSWORD must never be added to Vercel
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Vektor API (server-only — never NEXT_PUBLIC_*)
# Exact list path / JSON shape still OPEN until confirmed.
# When both are set, Settings can select Vektor REST API. That path never calls MCP.
VEKTOR_API_BASE_URL=
VEKTOR_API_TOKEN=
# Optional. When set, REST import uses only this path template.
# Placeholders: {from} {to} {page} {perPage}
VEKTOR_API_MANIFESTS_PATH=

# Encrypts Vektor OAuth tokens at rest. Server only. Never NEXT_PUBLIC_*.
# Use a long random value (for example: openssl rand -base64 32).
VEKTOR_TOKEN_ENCRYPTION_KEY=

# Optional. When empty, Connect Vektor uses this site's origin + /api/vektor/oauth/callback.
VEKTOR_OAUTH_REDIRECT_URI=

# Optional. Lets Overview read private truck Google Sheets.
# Share each sheet with this account as a viewer. Never NEXT_PUBLIC_*.
# Prefer the full service account JSON on Vercel (one value, email and key together).
# When JSON is set, the email and private key below are not used.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Or set the email and PEM. Newlines in the PEM may be written as \n.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Optional. Sheets API key for spreadsheets that are already public.
# A key does not unlock a private sheet. Prefer the service account for those.
GOOGLE_SHEETS_API_KEY=

# Set to true only when an Intuit developer app exists. Left blank, Connect QuickBooks stays hidden.
QUICKBOOKS_API_ENABLED=

# Optional. Google AI Studio key for an unknown fuel or toll file layout, and for suggestions on flagged rows.
# Server only. Never NEXT_PUBLIC_*. Set on Vercel Production and Preview when suggestions are wanted.
# A missing or rejected key stays on the rules, with no error. The key is sent as X-goog-api-key, never in the URL.
# Integrations shows AI status: OK, Busy, or Not set. The check does not print the key.
# Optional model override. Default is gemini-flash-latest.
GEMINI_API_KEY=
GEMINI_MODEL=

# QuickBooks Online for the Legacy Inc company. Server only. Never NEXT_PUBLIC_*.
# INTUIT_ENVIRONMENT is sandbox or production, and it must match the key set below.
INTUIT_CLIENT_ID=
INTUIT_CLIENT_SECRET=
# Must match the redirect URI saved in the Intuit developer portal, character for character.
# Production: https://tret.ai.alphasolutions.software/api/quickbooks/oauth/callback
INTUIT_REDIRECT_URI=
INTUIT_ENVIRONMENT=
# Encrypts QuickBooks tokens at rest. A separate secret from VEKTOR_TOKEN_ENCRYPTION_KEY.
# Example: openssl rand -base64 32
QUICKBOOKS_TOKEN_ENCRYPTION_KEY=
